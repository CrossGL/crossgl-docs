PROJECT_NAME           = "Infrintia"
PROJECT_BRIEF          = "Decentralized GPU compute marketplace"
OUTPUT_DIRECTORY       = docs/doxygen/build/infrintia
INPUT                  = _external/infrintia/app _external/infrintia/host_agent _external/infrintia/sdk ../infrintia/app ../infrintia/host_agent ../infrintia/sdk
RECURSIVE              = YES
FILE_PATTERNS          = *.py
EXCLUDE_PATTERNS       = */__pycache__/* */.pytest_cache/* */.mypy_cache/* */.ruff_cache/* */venv/* */worker_envs/*
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
